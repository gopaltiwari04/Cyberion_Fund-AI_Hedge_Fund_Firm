# Copy to .env for local development. Never commit real values.
# Variables marked [render] must also be set on the Render API service,
# [vercel] on the Vercel frontend, [airflow] in the Airflow container.

# ---- Core -------------------------------------------------------------------
ENVIRONMENT=development                 # [render] production
DATABASE_URL=postgresql://quant_user:quant_password@localhost:5432/quant_db   # [render][airflow] (compose overrides for containers)
INTERNAL_API_SECRET=                    # [render][vercel] shared HMAC secret; generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
FRONTEND_ORIGINS=http://localhost:3000  # [render] comma-separated allowed origins
RUN_MIGRATIONS_ON_STARTUP=false         # [render] true (advisory-locked alembic upgrade on boot)
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | text

# ---- Local infrastructure (docker-compose defaults; change for any shared host) --
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=quant_db
POSTGRES_PORT=5432                      # host port; change if another Postgres uses 5432
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
NEO4J_PASSWORD=quant_password
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
STORAGE_BACKEND=s3                      # s3 (MinIO) | local (filesystem, tests)

# ---- Data providers --------------------------------------------------------
SEC_USER_AGENT="YourCompany contact@yourdomain.com"   # [airflow] required by SEC fair-access policy
MARKETAUX_API_TOKEN=                    # [airflow] news (free tier: 3 articles/request, 100 requests/day)
MARKETAUX_PAGES=2
FRED_API_KEY=                           # [airflow] optional; falls back to the public fredgraph CSV
NEWSAPI_KEY=                            # legacy NewsAPI scripts only (not scheduled)

# ---- AI ------------------------------------------------------------------------
GEMINI_API_KEY=                         # [render] SEC analyst generation; without it the analyst returns cited passages only
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODELS=gemini-flash-latest   # tried in order if the primary model is unavailable
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDINGS=auto                     # auto | off

# ---- Operations ----------------------------------------------------------------
ALERT_WEBHOOK_URL=                      # [airflow] Slack-compatible webhook for pipeline/monitoring alerts
PRODUCTION_DATABASE_URL=                # [airflow] Render external DB URL; enables the publish_to_production task
UNIVERSE_TICKERS=                       # optional subset of the supported universe
SEC_RAG_YEARS=3
SEC_MAX_DOWNLOADS_PER_RUN=400
